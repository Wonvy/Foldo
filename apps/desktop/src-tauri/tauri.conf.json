{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foldo",
  "version": "0.1.0",
  "identifier": "com.wonvy.foldo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foldo",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "按规则整理文件夹",
    "longDescription": "Foldo 用规则自动整理文件夹：先预览、再执行，执行过的操作可以撤销。",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENTE3QTc0Nzg5Q0I2NDAKUldSQXRweDRkSHBSamFDMTNkNml4c2RuMmNMVDlMUTRabkxCM21aRlF3TCtaWmtiVzNNeTh0RHcK",
      "endpoints": [
        "https://github.com/Wonvy/Foldo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
